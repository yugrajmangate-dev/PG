        "vendor/jszip.min.js",
        "page-guard.js",
        "vendor/pdfjs/pdf.min.js",
        "vendor/pdfjs/pdf.worker.min.js",
        "vendor/tesseract/worker.min.js",
        "vendor/tesseract/tesseract-core.wasm.js",
        "vendor/tesseract/tesseract-core.wasm",
        "vendor/tesseract/tesseract-core-simd.wasm.js",
        "vendor/tesseract/tesseract-core-simd.wasm",
        "vendor/tessdata/*",
        "vendor/tessdata/eng.traineddata/eng.traineddata"
        ,
        "ml/js_inference_example.js",
        "ml/models/vectorizer.json",
        "ml/models/classifier.json",
        "ml/models/classes.json"
      ],
      "matches": ["<all_urls>"]
    }
